VITE_AIA_API_KEY=your-aia-api-key-here

# Local judge for `htrcli bench run --judge-cmd docs/benchmarks/judges/openai-judge.sh`
# The adapter has NO defaults: every variable below must be set where the bench
# runs, or the judge fails fast instead of guessing an endpoint.
# Use `JUDGE_AUTH=none` for a local llama-server, `bearer` for a hosted endpoint
# (which then also needs JUDGE_API_TOKEN).
JUDGE_URL=http://127.0.0.1:8089/v1/chat/completions
JUDGE_MODEL=your-model-id
JUDGE_AUTH=none
JUDGE_API_TOKEN=
